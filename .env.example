# Template for .env.dev (dev-em.cfqs.com) and .env.prod (em.cfqs.com).
# Each gets its own random SECRET_KEY and Postgres password:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# dev: true. prod: false.
DEBUG=false
SECRET_KEY=change-me
# dev: dev-em.cfqs.com,localhost. prod: em.cfqs.com.
ALLOWED_HOSTS=em.cfqs.com
# dev: https://dev-em.cfqs.com. prod: https://em.cfqs.com.
CSRF_TRUSTED_ORIGINS=https://em.cfqs.com
SIGNUP_ENABLED=false
DATABASE_URL=postgres://extended_mind:change-me@db:5432/extended_mind

POSTGRES_USER=extended_mind
POSTGRES_PASSWORD=change-me
POSTGRES_DB=extended_mind
